# Mismo proyecto de Supabase que usa auge-app (Project Settings -> API).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# service_role del mismo proyecto de Supabase — la necesita el cron de
# seguimiento para leer y actualizar diagnosticos sin sesión. Pégala tú
# misma en Vercel (Settings -> Environment Variables), nunca en el chat.
# Está en Supabase: Project Settings -> API Keys -> pestaña "Legacy anon,
# service_role API keys".
SUPABASE_SERVICE_ROLE_KEY=

# Cualquier cadena aleatoria larga. Vercel la envía automáticamente como
# cabecera Authorization al llamar al cron, así el endpoint solo responde
# a Vercel y no a cualquiera que descubra la URL.
CRON_SECRET=

# API key de Resend (resend.com) para enviar los emails automáticos del
# diagnóstico. Necesita el dominio augestudio.es verificado en Resend.
RESEND_API_KEY=

# Google Ads (no son secretos). Sin NEXT_PUBLIC_GOOGLE_ADS_ID no se carga
# ninguna etiqueta ni aviso de cookies. Tras cambiarlos, vuelve a desplegar.
# Google Ads -> Objetivos -> Conversiones -> (acción) -> Configurar etiqueta
# -> "Instalar la etiqueta tú mismo": el ID es AW-XXXXXXXXXX y la etiqueta
# es lo que va detrás de la barra en send_to ('AW-XXXXXXXXXX/ETIQUETA').
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONV_DIAGNOSTICO=
NEXT_PUBLIC_GOOGLE_ADS_CONV_WHATSAPP=
